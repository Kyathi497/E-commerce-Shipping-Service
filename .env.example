# Values for running on your machine (`pnpm dev`) against the Docker database
# (`docker compose up mysql`). Inside Docker Compose, hosts and ports are
# overridden in docker-compose.yml.
PORT=4008

DB_HOST=localhost
DB_PORT=3312
MYSQL_USER=shipping
MYSQL_PASSWORD=shipping
MYSQL_DATABASE=shipping

# auth-service's public keys, for checking admin tokens.
AUTH_JWKS_URL=http://localhost:4001/internal/.well-known/jwks.json
# Shared by all services for service-to-service calls. Required in production
# (at least 32 random characters, e.g. `openssl rand -base64 48`).
# SERVICE_TOKEN_SECRET=

# mock (no account, for dev and CI) or shiprocket.
SHIPPING_PROVIDER=mock
# Shiprocket API user (Settings → API → Configure), not your main login.
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# Encrypts the cached Shiprocket token: `openssl rand -base64 32`. Required in production.
# TOKEN_ENCRYPTION_KEY=
PICKUP_PINCODE=520003
# Mock only: comma-separated PIN codes it treats as undeliverable / prepaid-only.
MOCK_UNSERVICEABLE=999999
MOCK_NO_COD=

PINCODE_CACHE_HOURS=24
PACKAGING_BASE_GRAMS=150
PACKAGING_PER_UNIT_GRAMS=60
# Charged when no shipping rule matches (rules are edited in the admin API).
FALLBACK_SHIPPING_PAISE=7000
