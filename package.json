{
  "name": "shipping-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "prisma generate && tsc -p tsconfig.json && concurrently -k -n tsc,node \"tsc -w --preserveWatchOutput -p tsconfig.json\" \"node --watch --env-file-if-exists=.env dist/main.js\"",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "test": "vitest run --dir src",
    "test:e2e": "vitest run --dir test"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "prisma": "7.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
